# Copy to .env and adjust. Never commit the real .env file.

# --- Database ---
POSTGRES_USER=ledger_app
POSTGRES_PASSWORD=change-me-in-real-deployments
POSTGRES_DB=cost_ledger
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://ledger_app:change-me-in-real-deployments@postgres:5432/cost_ledger

# --- Redis (fast running-total store for the budget engine) ---
REDIS_URL=redis://redis:6379/0

# --- Bedrock client ---
# "mock" (default, no AWS account required) or "boto3" (real AWS Bedrock calls).
BEDROCK_CLIENT_MODE=mock
AWS_REGION=ap-south-1
# Only used when BEDROCK_CLIENT_MODE=boto3 — provide via your shell/secrets
# manager, never hardcode:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Auth ---
# Service-to-service API keys for the six simulated systems (comma-separated
# system:key pairs). Rotate for any real deployment.
SERVICE_API_KEYS=assistant:dev-assistant-key,logistics:dev-logistics-key,bridge:dev-bridge-key,support:dev-support-key,safety:dev-safety-key,monitoring:dev-monitoring-key
JWT_SECRET=change-me-dev-only-not-for-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
# Single admin account for the dashboard in this build — no user management
# system exists yet (UNKNOWN/out of scope for this build; see docs/architecture.md).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-dev-only

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# --- Frontend (Next.js) ---
# Host-side port the API is published on (see docker-compose.yml — remapped
# off the 8000/5432/6379 defaults because other local projects on this
# machine already use them). Baked in at build time (NEXT_PUBLIC_*), so
# rebuild the web image if this changes.
NEXT_PUBLIC_API_BASE_URL=http://localhost:58000

# --- Ceiling-check fail-safe direction (see docs/architecture.md Section 7) ---
# When Redis is unreachable: degrade-mode decisions fail OPEN (allow, protect
# the customer); hard_stop-mode decisions fail CLOSED (block, protect the
# budget). This is fixed behavior, not configurable — listed here for
# visibility only.
